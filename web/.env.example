# Names only. Real values go into Vercel (Project > Settings > Environment
# Variables) or into a local .env.local, which is not committed.

# Feedback e-mail (all three are needed, otherwise /api/feedback answers 503):
RESEND_API_KEY=
FEEDBACK_TO=
FEEDBACK_FROM="ClipForge feedback <feedback@your-domain>"

# Optional: Cloudflare Turnstile check on the feedback form (both or neither).
TURNSTILE_SECRET=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Optional: the public address of the site, for the sitemap and link previews.
# On Vercel it is worked out by itself; set it when you add a custom domain.
NEXT_PUBLIC_SITE_URL=
